# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL - matches pgAdmin)
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_NAME=sd_maintenance
DB_PORT=5432

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h
RESET_TOKEN_EXPIRES_MINUTES=30

# Password given to bulk-uploaded users whose Password cell is blank
DEFAULT_USER_PASSWORD=Welcome@123

# Email (SMTP - password reset and notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="SD Maintenance <you@example.com>"

# SD notifications (status changes to Passive + date reminders)
# Comma-separated recipients of every SD notification email
NOTIFY_TO=sd-team@example.com
# Reminder job: daily run time (server time, HH:MM) and how many days ahead
NOTIFY_TIME=08:00
NOTIFY_DAYS_BEFORE=15
# false = do not schedule the daily reminder job on this server
NOTIFY_ENABLED=true
# true = build and log emails as 'DryRun' without sending (test / UAT)
EMAIL_DRY_RUN=false
